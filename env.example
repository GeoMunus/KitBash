# Variables for the Railway service (Service -> Variables). Nothing here is committed with a real value.

# REQUIRED. Your owner key: approves agent connections, approvals, deletes, and opens the Team tab. 12+ random characters.
OWNER_SECRET=

# Optional: only for the embedded OpenAI agent. Leave both unset if you don't use it.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: force the public address (otherwise Railway's generated domain is used). Include https://
# PUBLIC_URL=https://your-app.up.railway.app

# Optional: pin the Node version if Railpack picks an older one (needs 22.13+).
# RAILPACK_NODE_VERSION=22

# Set automatically by Railway when you attach a Volume; the database file goes inside it. Do not set by hand.
# RAILWAY_VOLUME_MOUNT_PATH=/data
# Only if you want the database somewhere else:
# DATABASE_PATH=/data/kitbash.db
